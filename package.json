{
  "name": "naudiodon2",
  "version": "2.4.2",
  "description": "Node Stream bindings for PortAudio.",
  "main": "./index.js",
  "types": "./index.d.ts",
  "keywords": [
    "portaudio",
    "audio",
    "play",
    "record",
    "wav",
    "raspberry pi"
  ],
  "bugs": {
    "url": "https://github.com/Streampunk/naudiodon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Streampunk/naudiodon.git"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "node-segfault-handler-rs": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@mapbox/node-pre-gyp": "^1.0.11",
    "node-pre-gyp-github": "^1.4.5"
  },
  "author": "Streampunk Media Ltd",
  "license": "Apache-2.0",
  "scripts": {
    "install": "node ./node_modules/@mapbox/node-pre-gyp/bin/node-pre-gyp install --fallback-to-build",
    "build": "node-gyp rebuild",
    "package": "node ./node_modules/@mapbox/node-pre-gyp/bin/node-pre-gyp package",
    "publish-binary": "node ./node_modules/node-pre-gyp-github/bin/node-pre-gyp-github publish",
    "build-all": "node scripts/build-binaries.js"
  },
  "gypfile": true,
  "binary": {
    "module_name": "naudiodon",
    "module_path": "./build/Release/",
    "remote_path": "./{name}/v{version}/",
    "package_name": "{node_abi}-{platform}-{arch}.tar.gz",
    "host": "https://github.com/Misterr-H/naudiodon2/releases/download/"
  }
}
